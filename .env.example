# ─── iyzico ───
# Sandbox test anahtarları iyzico sandbox hesabından alınır (https://sandbox-merchant.iyzipay.com).
# Production'a geçerken üçü de gerçek merchant değerleriyle değiştirilmeli.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ─── Firebase Admin SDK (server-side) ───
# Firebase Console → Proje Ayarları → Servis Hesapları → "Yeni özel anahtar oluştur"
# ile indirilen JSON dosyasındaki alanlar buraya girilir. private_key'deki satır
# sonlarını \n olarak (tek satırda) bırak, Vercel env değişkeni de böyle bekler.
FIREBASE_PROJECT_ID=efemiletisim
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Site ───
# 3DS callback/webhook'ların hangi origin'e ait olduğunu doğrulamak ve
# redirect URL'leri üretmek için kullanılır (prod: https://efemiletisim.com).
SITE_URL=http://localhost:3000
