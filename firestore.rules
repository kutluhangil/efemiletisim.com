rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Kullanicilar sadece kendi verilerini okuyabilir/yazabilir.
    //
    // ⚠️ GEÇİCİ: `orders` alanı hâlâ istemciden yazılabiliyor. Bu yalnızca
    // sunucu sipariş API'si (FIREBASE_SERVICE_ACCOUNT env'i) yapılandırılmadan
    // önce EFT/havale siparişlerinin kaybolmaması için açık bırakıldı.
    // Sunucu tarafı yapılandırıldıktan sonra aşağıdaki katı kural
    // kullanılmalıdır (sipariş yazma yetkisi yalnız Admin SDK'da kalır):
    //
    //   allow read: if request.auth != null && request.auth.uid == userId;
    //   allow write: if request.auth != null && request.auth.uid == userId
    //                && !request.resource.data.diff(resource.data)
    //                        .affectedKeys().hasAny(['orders']);
    //
    // Bkz. docs/IYZICO-DENETIM-RAPORU.md → bulgu F-06.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Siparişler: TEK otorite sunucudur. İstemci hiçbir koşulda sipariş
    // oluşturamaz/güncelleyemez; yalnız üye kendi siparişini okuyabilir.
    // Yazma işlemleri Firebase Admin SDK ile (kurallardan muaf) yapılır.
    match /orders/{orderId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Ürün kataloğu: admin panelinden yönetilen ürünler.
    // Okuma herkese kapalı DEĞİL ama site katalogu kendi API'sinden
    // (/api/catalog) okuduğu için istemcinin buraya doğrudan erişmesi
    // gerekmez; yine de ileride Firebase SDK ile okunmak istenirse diye
    // okuma açık bırakıldı.
    //
    // Yazma tamamen kapalıdır: ürün fiyatı sipariş tutarını belirlediği
    // için katalog yalnız /api/admin/products üzerinden, sunucuda
    // doğrulanmış yönetici yetkisiyle (Admin SDK, kurallardan muaf)
    // değiştirilebilir.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // İndirim kuponları: tanım da fiyat kadar hassastır (tutarı değiştirir).
    // İstemci kupon listesini GÖREMEZ — sepette girilen kod sunucuda
    // (/api/coupon/validate) doğrulanır. Yazma yalnız Admin SDK ile.
    match /coupons/{couponCode} {
      allow read, write: if false;
    }

    // Ödeme olay günlüğü (callback/webhook idempotency + mutabakat):
    // tamamen sunucuya aittir, istemciye kapalıdır.
    match /paymentEvents/{eventId} {
      allow read, write: if false;
    }

    // Stok bildirimi talepleri: herkes (misafir dahil) oluşturabilir,
    // e-posta içerdiği için kimse okuyamaz/güncelleyemez/silemez.
    match /stockAlerts/{alertId} {
      allow create: if request.resource.data.keys().hasAll(['productId', 'email', 'createdAt'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 200
                    && request.resource.data.productId is int;
      allow read, update, delete: if false;
    }

    // Mail kuyruğu: "Trigger Email from Firestore" Firebase Extension'ı bu koleksiyonu
    // izler ve buraya yazılan her dokümanı e-posta olarak gönderir (bkz. docs/EMAIL-KURULUMU.md).
    // İstismarı önlemek için hedef adres ya destek kutusu ya da isteği yapan kullanıcının
    // kendi doğrulanmış e-postası olmak zorundadır; okuma/güncelleme/silme yalnızca
    // extension'ın kullandığı admin yetkisiyle (kurallardan muaf) yapılabilir.
    match /mail/{mailId} {
      allow create: if request.resource.data.keys().hasAll(['to', 'message'])
                    && request.resource.data.message.keys().hasAll(['subject', 'html'])
                    && request.resource.data.message.subject is string
                    && request.resource.data.message.subject.size() < 200
                    && request.resource.data.message.html is string
                    && request.resource.data.message.html.size() < 20000
                    && (
                         request.resource.data.to == 'destek@efemiletisim.com'
                         || (request.auth != null && request.resource.data.to == request.auth.token.email)
                       );
      allow read, update, delete: if false;
    }

    // Ürün soru-cevap: herkes okuyabilir ve soru oluşturabilir;
    // cevap alanı sadece null olarak oluşturulabilir (yanıtlama şimdilik Firebase Console'dan yapılır,
    // admin panelinden yanıtlama akışı henüz kurulmadı).
    match /productQuestions/{questionId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['productId', 'question', 'answer', 'createdAt'])
                    && request.resource.data.question is string
                    && request.resource.data.question.size() > 0
                    && request.resource.data.question.size() < 500
                    && request.resource.data.answer == null
                    && request.resource.data.productId is int;
      allow update, delete: if false;
    }

    // Siparişler: SADECE Vercel Function'ların Firebase Admin SDK ile yazdığı
    // top-level koleksiyon (bkz. api/_lib/orders.js) — client burada asla
    // create yapamaz, bu yüzden client kendi kendine sahte "başarılı sipariş"
    // yazamaz (ödeme simülasyonu döneminde localStorage'da mümkündü).
    // Sahibi kendi siparişini, admin (custom claim) tüm siparişleri okuyabilir.
    // Durum/kargo takip güncellemesi admin panelinden client SDK ile yapılır.
    match /orders/{orderId} {
      allow read: if request.auth != null
                  && (request.auth.token.admin == true || resource.data.userId == request.auth.uid);
      allow create: if false;
      allow update: if request.auth != null && request.auth.token.admin == true;
      allow delete: if false;
    }

    // 3DS ödeme taslakları: tamamen sunucu içi (Admin SDK) — client'ın
    // buraya hiçbir erişimi yok, iyzico callback/webhook akışının ara durumu.
    match /paymentAttempts/{attemptId} {
      allow read, write: if false;
    }
  }
}
